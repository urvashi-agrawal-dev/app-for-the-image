# Copy this file to .env and fill in the values. Do NOT commit secrets.

# OpenAI
OPENAI_API_KEY=

# Database (Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/advisortrends

# Server
PORT=5000
NODE_ENV=development
SERVER_URL=http://127.0.0.1:5000

# Session secret (random long string)
SESSION_SECRET=

# SendGrid (optional - for production email delivery)
SENDGRID_API_KEY=
SENDER_EMAIL=no-reply@yourdomain.com

# If using Replit OIDC (optional)
REPL_ID=
ISSUER_URL=https://replit.com/oidc
